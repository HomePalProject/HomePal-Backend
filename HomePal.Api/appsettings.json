{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=YOUR_DATABASE_NAME;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtOptions": {
    "Issuer": "HomePal.Api",
    "Audience": "HomePal.Client",
    "SecretKey": "YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 30
  },
  "MailKitOptions": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_EMAIL_USERNAME@gmail.com",
    "Password": "YOUR_EMAIL_APP_PASSWORD",
    "EnableSsl": true,
    "SenderName": "HomePal Team",
    "SenderEmail": "noreply@homepal.com"
  },
  "GoogleAuthOptions": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "AndroidClientId": "YOUR_ANDROID_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "ClientOptions": {
    "BaseUrl": "http://localhost:3000"
  }
}